APP_NAME="Cabanas Playa Terco"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.com
FRONTEND_URL=https://tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
DASHBOARD_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
UPLOADS_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Sanctum
SANCTUM_STATEFUL_DOMAINS=tudominio.com,www.tudominio.com

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="cabanasplayaterco@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO_ADDRESS="cabanasplayaterco@gmail.com"

# Optional: DigitalOcean Spaces / S3. Only fill these if UPLOADS_DISK=s3.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=cabanas-playa-terco
DO_SPACES_ROOT=cabanasPlayaTerco/production
DO_SPACES_URL=https://cabanas-playa-terco.nyc3.digitaloceanspaces.com

AWS_ACCESS_KEY_ID="${DO_SPACES_KEY}"
AWS_SECRET_ACCESS_KEY="${DO_SPACES_SECRET}"
AWS_DEFAULT_REGION="${DO_SPACES_REGION}"
AWS_BUCKET="${DO_SPACES_BUCKET}"
AWS_ROOT="${DO_SPACES_ROOT}"
AWS_URL="${DO_SPACES_URL}"
AWS_ENDPOINT="${DO_SPACES_ENDPOINT}"
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# Resend (production email)
RESEND_API_KEY=

# Firebase Cloud Messaging for the mobile admin app
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

VITE_APP_NAME="${APP_NAME}"
